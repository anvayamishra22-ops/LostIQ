# Server configurations
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB Connection URI (e.g. mongodb://localhost:27017/lost_iq or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/lost_iq

# JWT Key
# A secret string used to sign JWT authorization tokens
JWT_SECRET=lost_iq_secret_key_123

# Cloudinary Setup (Optional - local fallback exists if keys are empty)
# Retrieve these values from your Cloudinary dashboard settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
